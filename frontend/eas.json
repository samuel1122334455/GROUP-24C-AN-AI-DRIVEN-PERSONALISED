{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "preview": {
      "channel": "preview",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://thrive.blazeaiautomations.com/api",
        "APP_ENV": "production"
      }
    },
    "production": {
      "channel": "production",
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://thrive.blazeaiautomations.com/api",
        "APP_ENV": "production"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
